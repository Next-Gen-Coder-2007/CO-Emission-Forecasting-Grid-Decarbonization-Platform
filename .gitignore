# ====================================================================
# Single Root .gitignore - CO2 Emission Forecasting Platform
# ====================================================================

# Local Databases (Connect via cloud connection string in production)
*.db
*.sqlite
*.sqlite3
backend/*.db
backend/*.sqlite
backend/*.sqlite3
co2_forecast.db

# Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Node.js & Frontend Artifacts
node_modules/
frontend/node_modules/
dist/
frontend/dist/
*.tsbuildinfo

# Python Artifacts & Caches
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# Vercel Deployment Artifacts
.vercel/

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Operating System & Editor Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
