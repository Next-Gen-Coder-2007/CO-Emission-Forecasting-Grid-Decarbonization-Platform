# ====================================================================
# CO2 Emission Prediction System - Environment Configuration Template
# ====================================================================

# Backend Flask Server Configuration
PORT=5000
HOST=0.0.0.0
FLASK_ENV=development
FLASK_DEBUG=True
CORS_ORIGINS=*

# Database Configuration (Cloud Connection String or Local SQLite)
# For production cloud deployment: set DATABASE_URL (e.g., postgresql://user:pass@host:port/dbname or libsql://...)
DATABASE_URL=
DATABASE_PATH=backend/db/co2_forecast.db

# Machine Learning & Deep Learning Models Directory
MODEL_DIR=backend/models

# Preprocessed EIA Dataset
CSV_PATH=backend/data/preprocessed_co2_dataset.csv

# Frontend API Base URL (Read by Vite via envDir: '../')
# In local dev: http://localhost:5000
# In Vercel serverless deployment: leave empty for same-origin serverless routing
VITE_API_URL=http://localhost:5000
